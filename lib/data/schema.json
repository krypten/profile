{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio Data Schema",
  "description": "JSON schema for validating portfolio data structure",
  "type": "object",
  "required": ["personal", "experience", "skills", "education"],
  "properties": {
    "personal": {
      "type": "object",
      "required": ["name", "tagline", "role", "bio", "contact"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "bio": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "object",
          "required": ["email", "linkedin", "github", "medium"],
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "linkedin": {
              "type": "string",
              "minLength": 1
            },
            "github": {
              "type": "string",
              "minLength": 1
            },
            "medium": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "required": ["ai", "security", "mobile", "robotics", "vr"],
      "properties": {
        "ai": {
          "$ref": "#/definitions/projectArray"
        },
        "security": {
          "$ref": "#/definitions/projectArray"
        },
        "mobile": {
          "$ref": "#/definitions/projectArray"
        },
        "robotics": {
          "$ref": "#/definitions/projectArray"
        },
        "vr": {
          "$ref": "#/definitions/projectArray"
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "required": ["technical", "leadership", "domains", "certifications"],
      "properties": {
        "technical": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leadership": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/education"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "projectArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/project"
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "description", "year", "technologies"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{4}|-(Present|present))?$"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "links": {
          "type": "object",
          "properties": {
            "github": {
              "type": ["string", "null"],
              "format": "uri"
            },
            "demo": {
              "type": ["string", "null"],
              "format": "uri"
            },
            "article": {
              "type": ["string", "null"],
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "impact": {
          "type": "string"
        },
        "company": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "required": ["degree", "institution", "period"],
      "properties": {
        "degree": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}